{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "background": null,
  "autosize": { "type": "fit", "contains": "padding" },
  "title": {
    "text": "Children enrolled in the year before full-time school, 2025",
    "subtitle": "Percentage of all children that age, by state and territory"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-132, 0]
  },
  "data": {
    "url": "data/au_states.topojson",
    "format": { "type": "topojson", "feature": "states" }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": { "url": "data/state_enrolment_2025.csv" },
        "key": "state_name",
        "fields": ["state", "enrolled_pct", "children_enrolled"]
      }
    },
    {
      "calculate": "datum.enrolled_pct < 85 ? 'Under 85%' : datum.enrolled_pct < 90 ? '85 to 90%' : datum.enrolled_pct < 95 ? '90 to 95%' : datum.enrolled_pct < 100 ? '95 to 100%' : '100% or more'",
      "as": "band"
    }
  ],
  "layer": [
    {
      "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 1.2 },
      "encoding": {
        "color": {
          "field": "band",
          "type": "nominal",
          "title": "Children enrolled",
          "scale": {
            "domain": ["Under 85%", "85 to 90%", "90 to 95%", "95 to 100%", "100% or more"],
            "range": ["#e8f3f1", "#b3dcd4", "#6dbab3", "#2a8c92", "#0f4c5c"]
          },
          "legend": { "orient": "right", "symbolType": "square", "symbolSize": 220, "offset": 6 }
        },
        "tooltip": [
          { "field": "properties.STATE_NAME", "title": "State" },
          { "field": "enrolled_pct", "title": "Enrolled (%)", "format": ".1f" },
          { "field": "children_enrolled", "title": "Children enrolled", "format": "," }
        ]
      }
    },
    {
      "data": {
        "values": [
          { "abbr": "WA", "state_name": "Western Australia", "lon": 122.0, "lat": -25.5, "ink": "white" },
          { "abbr": "NT", "state_name": "Northern Territory", "lon": 133.4, "lat": -19.5, "ink": "dark" },
          { "abbr": "SA", "state_name": "South Australia", "lon": 135.0, "lat": -30.2, "ink": "dark" },
          { "abbr": "Qld", "state_name": "Queensland", "lon": 144.6, "lat": -22.6, "ink": "dark" },
          { "abbr": "NSW", "state_name": "New South Wales", "lon": 146.6, "lat": -32.4, "ink": "dark" },
          { "abbr": "Vic", "state_name": "Victoria", "lon": 144.2, "lat": -37.2, "ink": "white" },
          { "abbr": "Tas", "state_name": "Tasmania", "lon": 148.6, "lat": -44.3, "ink": "dark" },
          { "abbr": "ACT", "state_name": "Australian Capital Territory", "lon": 153.3, "lat": -35.6, "ink": "dark" }
        ]
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": { "url": "data/state_enrolment_2025.csv" },
            "key": "state_name",
            "fields": ["enrolled_pct"]
          }
        },
        {
          "calculate": "datum.abbr + '  ' + format(datum.enrolled_pct, '.0f') + '%'",
          "as": "label"
        }
      ],
      "mark": { "type": "text", "fontSize": 13, "fontWeight": "bold" },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "label", "type": "nominal" },
        "color": {
          "condition": { "test": "datum.ink == 'white'", "value": "white" },
          "value": "#22333b"
        }
      }
    },
    {
      "data": {
        "values": [
          { "lon": 122.0, "lat": -25.5, "note": "Above 100%", "ink": "white" },
          { "lon": 133.4, "lat": -19.5, "note": "Lowest", "ink": "dark" },
          { "lon": 135.0, "lat": -30.2, "note": "Lowest", "ink": "dark" }
        ]
      },
      "mark": { "type": "text", "fontSize": 11, "fontStyle": "italic", "dy": 16 },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "note", "type": "nominal" },
        "color": {
          "condition": { "test": "datum.ink == 'white'", "value": "white" },
          "value": "#22333b"
        }
      }
    }
  ],
  "config": {
    "font": "Nunito, Arial, sans-serif",
    "view": { "stroke": null },
    "title": { "anchor": "start" }
  }
}