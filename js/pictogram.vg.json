{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 330,
  "height": 330,
  "background": "#fbf8f1",
  "title": {
    "text": "Of every 100 children in the year before school, 92 are enrolled",
    "subtitle": "Australia, 2025. Each figure is one child."
  },
  "data": { "sequence": { "start": 0, "stop": 100, "as": "id" } },
  "transform": [
    { "calculate": "datum.id % 10", "as": "col" },
    { "calculate": "floor(datum.id / 10)", "as": "row" },
    {
      "calculate": "datum.id < 92 ? 'Enrolled in a preschool program' : 'Not enrolled'",
      "as": "status"
    }
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "shape": "M0.3,-0.55 A0.3,0.3 0 1,1 -0.3,-0.55 A0.3,0.3 0 1,1 0.3,-0.55 Z M-0.5,0.95 L-0.5,0.05 Q-0.5,-0.15 -0.3,-0.15 L0.3,-0.15 Q0.5,-0.15 0.5,0.05 L0.5,0.95 Z",
    "size": 520
  },
  "encoding": {
    "x": { "field": "col", "type": "ordinal", "axis": null },
    "y": { "field": "row", "type": "ordinal", "axis": null, "sort": "descending" },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": ["Enrolled in a preschool program", "Not enrolled"],
        "range": ["#1b7f8c", "#cfcabd"]
      },
      "legend": { "orient": "bottom", "title": null }
    }
  },
  "config": {
    "font": "Nunito, Arial, sans-serif",
    "view": { "stroke": null },
    "title": { "anchor": "start" }
  }
}